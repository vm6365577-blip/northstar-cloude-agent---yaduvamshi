# ============================================================
# AWS Configuration
# ============================================================
AWS_REGION=us-east-1
# Credentials can be set here or retrieved via AWS CLI / IAM Role / ~/.aws/credentials
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=your-optional-session-token

# ============================================================
# Amazon S3 & Lakehouse Configuration
# ============================================================
AWS_S3_BUCKET=northstar-retail-lakehouse
ATHENA_DATABASE=northstar_lakehouse
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_LOCATION=s3://northstar-retail-lakehouse/athena-results/

# Medallion Layers
BRONZE_DATASET=bronze
SILVER_DATASET=silver
GOLD_DATASET=gold

# Gold Lakehouse Tables
FACT_SALES_TABLE=fact_sales
DIM_PRODUCT_TABLE=dim_product
DIM_DATE_TABLE=dim_date
DOCUMENT_TABLE=product_documents

# ============================================================
# Amazon Bedrock LLM & Embeddings Configuration
# ============================================================
# Default: Claude 3.5 Sonnet v2 (or anthropic.claude-3-haiku-20240307-v1:0 / amazon.nova-pro-v1:0)
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
